# From @BotFather
TELEGRAM_BOT_TOKEN=

# Private channel the bot forwards into to read message content.
# The bot must be an administrator there. Channel ids start with -100.
ARCHIVE_CHAT_ID=

# GitHub App credentials
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

CONFIG_PATH=./gitgram.yaml
PORT=3000

# Must be one of Telegram's standard reaction emoji (see src/reactions.ts).
TRIGGER_EMOJI=👀
ACK_EMOJI=👌
