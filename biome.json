{
	"$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**/*.ts", "**/*.json", "!node_modules", "!renovate.json"]
	},
	"formatter": {
		"enabled": false,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": false,
			"a11y": {
				"recommended": true
			},
			"complexity": {
				"noEmptyTypeParameters": "on",
				"noFlatMapIdentity": "on",
				"noThisInStatic": "on",
				"noUselessContinue": "on",
				"noUselessEscapeInRegex": "on",
				"noUselessStringRaw": "on",
				"noUselessThisAlias": "on",
				"useArrowFunction": "on",
				"useOptionalChain": "on",
				"useSimpleNumberKeys": "on"
			},
			"correctness": {
				"noConstantMathMinMaxClamp": "on",
				"noStringCaseMismatch": "on",
				"noUnusedFunctionParameters": "on",
				"noUnusedImports": "on",
				"noUnusedPrivateClassMembers": "on",
				"noUnusedVariables": "on",
				"noVoidTypeReturn": "on"
			},
			"performance": {
				"noDynamicNamespaceImportAccess": "on"
			},
			"style": {
				"useExportType": "on",
				"useImportType": "on"
			},
			"suspicious": {
				"noAssignInExpressions": "on",
				"noBiomeFirstException": "on",
				"noConfusingLabels": "on",
				"noConstEnum": "on",
				"noEmptyInterface": "on",
				"noGlobalIsFinite": "on",
				"noGlobalIsNan": "on",
				"noImplicitAnyLet": "on",
				"noQuickfixBiome": "on",
				"noRedeclare": "on",
				"noRedundantUseStrict": "on",
				"noTsIgnore": "on",
				"noUselessEscapeInString": "on",
				"useBiomeIgnoreFolder": "on"
			}
		}
	},
	"assist": {
		"enabled": false
	}
}
