{
	"name": "gitgram",
	"version": "0.0.0",
	"description": "React to a Telegram message, get a GitHub issue.",
	"type": "module",
	"private": true,
	"scripts": {
		"start": "bun run src/index.ts",
		"dev": "bun --watch src/index.ts",
		"test": "bun test",
		"lint": "biome lint .",
		"fmt": "biome format --write .",
		"fmt:check": "biome format .",
		"check": "biome check .",
		"typecheck": "tsc --noEmit",
		"ci": "biome check . && tsc --noEmit && bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@types/bun": "^1.3.14",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@octokit/auth-app": "^8.3.0",
		"@octokit/webhooks": "^14.2.0",
		"grammy": "^1.45.1",
		"hono": "^4.13.3",
		"octokit": "^5.0.5",
		"zod": "^4.4.3"
	},
	"packageManager": "bun@1.3.14"
}
