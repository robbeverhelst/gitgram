{
	"name": "gitgram",
	"version": "0.1.0",
	"private": true,
	"description": "React to a Telegram message, get a GitHub issue.",
	"type": "module",
	"scripts": {
		"start": "bun run src/index.ts",
		"dev": "bun --watch src/index.ts",
		"test": "bun test",
		"format": "bunx bun@1.4.3-canary.20261014.1 fmt .",
		"format:check": "bunx bun@1.4.3-canary.20261014.1 fmt --check .",
		"lint:check": "bunx bun@1.4.3-canary.20261014.1 lint . && biome lint .",
		"lint:fix": "bunx bun@1.4.3-canary.20261014.1 lint --fix . && biome lint --write .",
		"check": "bun run format:check && bun run lint:check && bun run typecheck",
		"typecheck": "bun --bun tsc --noEmit",
		"check:bun-native": "bun run scripts/check-bun-native.ts",
		"ci": "bun run check:bun-native && bun run format:check && bun run lint:check && bun --bun tsc --noEmit && bun test"
	},
	"dependencies": {
		"@octokit/auth-app": "^8.3.0",
		"@octokit/webhooks": "^14.2.0",
		"grammy": "^1.45.1",
		"hono": "^4.13.3",
		"octokit": "^5.0.5",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@types/bun": "^1.3.14",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.4.4"
}
