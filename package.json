{
	"name": "gitgram",
	"version": "0.1.0",
	"description": "React to a Telegram message, get a GitHub issue.",
	"type": "module",
	"private": true,
	"scripts": {
		"start": "bun run src/index.ts",
		"dev": "bun --watch src/index.ts",
		"test": "bun test",
		"check:lint": "bunx bun@1.4.3-canary.20261014.1 lint",
		"fix:lint": "bunx bun@1.4.3-canary.20261014.1 lint --fix",
		"check:fmt": "bunx bun@1.4.3-canary.20261014.1 fmt --check",
		"fix:fmt": "bunx bun@1.4.3-canary.20261014.1 fmt",
		"typecheck": "bun --bun tsc --noEmit",
		"check:bun-native": "bun run scripts/check-bun-native.ts",
		"ci": "bun run check:bun-native && bun run check:lint && bun run check:fmt && bun --bun tsc --noEmit && bun test"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@octokit/auth-app": "^8.3.0",
		"@octokit/webhooks": "^14.2.0",
		"grammy": "^1.45.1",
		"hono": "^4.13.3",
		"octokit": "^5.0.5",
		"zod": "^4.4.3"
	},
	"packageManager": "bun@1.4.3"
}
